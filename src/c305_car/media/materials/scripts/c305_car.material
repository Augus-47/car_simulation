    }
  }
}

material C305Car/GreyTransparent
{
  technique
  {
    pass
    {
      scene_blend alpha_blend
      depth_write off
      lighting off
      texture_unit
      {
        colour_op_ex source1 src_manual src_current 0.75 0.75 0.78
