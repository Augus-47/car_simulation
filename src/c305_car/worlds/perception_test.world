<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="perception_test">
    <physics name="ode_physics" default="1" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.42 0.42 0.42 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>true</shadows>
      <fog>
        <type>linear</type>
        <color>0.72 0.78 0.82 1</color>
        <density>0.0</density>
        <start>35</start>
        <end>100</end>
      </fog>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.88 0.84 0.76 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <!-- Base terrain and the drivable asphalt corridor. -->
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>100 50 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>100 50 0.10</size></box></geometry>
          <material><ambient>0.18 0.35 0.16 1</ambient><diffuse>0.20 0.42 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="asphalt_road">
      <static>true</static>
      <pose>10 0 0.06 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>80 14 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>80 14 0.10</size></box></geometry>
          <material><ambient>0.10 0.11 0.12 1</ambient><diffuse>0.16 0.17 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Raised sidewalks provide strong curb returns in the lidar scan. -->
    <model name="sidewalks">
      <static>true</static>
      <link name="north"><pose>10 8 0.16 0 0 0</pose><collision name="c"><geometry><box><size>80 2 0.30</size></box></geometry></collision><visual name="v"><geometry><box><size>80 2 0.30</size></box></geometry><material><ambient>0.42 0.42 0.40 1</ambient><diffuse>0.58 0.58 0.55 1</diffuse></material></visual></link>
      <link name="south"><pose>10 -8 0.16 0 0 0</pose><collision name="c"><geometry><box><size>80 2 0.30</size></box></geometry></collision><visual name="v"><geometry><box><size>80 2 0.30</size></box></geometry><material><ambient>0.42 0.42 0.40 1</ambient><diffuse>0.58 0.58 0.55 1</diffuse></material></visual></link>
    </model>

    <!-- Visual-only lane markings: center dashes, edge lines, and crosswalk. -->
    <model name="road_markings">
      <static>true</static>
      <link name="markings">
        <visual name="north_edge"><pose>10 6.5 0.121 0 0 0</pose><geometry><box><size>80 0.12 0.012</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="south_edge"><pose>10 -6.5 0.121 0 0 0</pose><geometry><box><size>80 0.12 0.012</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="dash_0"><pose>-24 0 0.121 0 0 0</pose><geometry><box><size>4 0.16 0.012</size></box></geometry><material><ambient>0.95 0.72 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="dash_1"><pose>-16 0 0.121 0 0 0</pose><geometry><box><size>4 0.16 0.012</size></box></geometry><material><ambient>0.95 0.72 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="dash_2"><pose>-8 0 0.121 0 0 0</pose><geometry><box><size>4 0.16 0.012</size></box></geometry><material><ambient>0.95 0.72 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="dash_3"><pose>0 0 0.121 0 0 0</pose><geometry><box><size>4 0.16 0.012</size></box></geometry><material><ambient>0.95 0.72 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="dash_4"><pose>8 0 0.121 0 0 0</pose><geometry><box><size>4 0.16 0.012</size></box></geometry><material><ambient>0.95 0.72 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="dash_5"><pose>16 0 0.121 0 0 0</pose><geometry><box><size>4 0.16 0.012</size></box></geometry><material><ambient>0.95 0.72 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="dash_6"><pose>24 0 0.121 0 0 0</pose><geometry><box><size>4 0.16 0.012</size></box></geometry><material><ambient>0.95 0.72 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="dash_7"><pose>32 0 0.121 0 0 0</pose><geometry><box><size>4 0.16 0.012</size></box></geometry><material><ambient>0.95 0.72 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="dash_8"><pose>40 0 0.121 0 0 0</pose><geometry><box><size>4 0.16 0.012</size></box></geometry><material><ambient>0.95 0.72 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="crosswalk_0"><pose>20 -5.5 0.122 0 0 0</pose><geometry><box><size>0.55 1.0 0.014</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="crosswalk_1"><pose>20 -3.9 0.122 0 0 0</pose><geometry><box><size>0.55 1.0 0.014</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="crosswalk_2"><pose>20 -2.3 0.122 0 0 0</pose><geometry><box><size>0.55 1.0 0.014</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="crosswalk_3"><pose>20 -0.7 0.122 0 0 0</pose><geometry><box><size>0.55 1.0 0.014</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="crosswalk_4"><pose>20 0.9 0.122 0 0 0</pose><geometry><box><size>0.55 1.0 0.014</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="crosswalk_5"><pose>20 2.5 0.122 0 0 0</pose><geometry><box><size>0.55 1.0 0.014</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="crosswalk_6"><pose>20 4.1 0.122 0 0 0</pose><geometry><box><size>0.55 1.0 0.014</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="crosswalk_7"><pose>20 5.7 0.122 0 0 0</pose><geometry><box><size>0.55 1.0 0.014</size></box></geometry><material><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Three vehicle-like targets with distinct size, pose, and color. -->
    <model name="blue_sedan">
      <static>true</static><pose>13 -3.3 0.68 0 0 0.04</pose>
      <link name="body">
        <collision name="body_collision"><geometry><box><size>4.2 1.8 1.15</size></box></geometry></collision>
        <visual name="body_visual"><geometry><box><size>4.2 1.8 1.15</size></box></geometry><material><ambient>0.04 0.18 0.55 1</ambient><diffuse>0.05 0.28 0.85 1</diffuse></material></visual>
        <visual name="cabin"><pose>-0.15 0 0.78 0 0 0</pose><geometry><box><size>2.1 1.65 0.55</size></box></geometry><material><ambient>0.06 0.12 0.16 1</ambient><diffuse>0.12 0.24 0.30 1</diffuse></material></visual>
      </link>
    </model>
    <model name="red_hatchback">
      <static>true</static><pose>30 3.4 0.64 0 0 3.10</pose>
      <link name="body">
        <collision name="body_collision"><geometry><box><size>3.5 1.75 1.05</size></box></geometry></collision>
        <visual name="body_visual"><geometry><box><size>3.5 1.75 1.05</size></box></geometry><material><ambient>0.52 0.03 0.03 1</ambient><diffuse>0.86 0.06 0.04 1</diffuse></material></visual>
        <visual name="cabin"><pose>-0.25 0 0.72 0 0 0</pose><geometry><box><size>1.75 1.55 0.52</size></box></geometry><material><diffuse>0.10 0.18 0.20 1</diffuse></material></visual>
      </link>
    </model>
    <model name="delivery_van">
      <static>true</static><pose>39 -3.4 1.18 0 0 0</pose>
      <link name="body">
        <collision name="body_collision"><geometry><box><size>5.2 2.15 2.15</size></box></geometry></collision>
        <visual name="body_visual"><geometry><box><size>5.2 2.15 2.15</size></box></geometry><material><ambient>0.72 0.70 0.10 1</ambient><diffuse>0.95 0.90 0.12 1</diffuse></material></visual>
        <visual name="windshield"><pose>-2.611 0 0.42 0 0 0</pose><geometry><box><size>0.02 1.75 0.72</size></box></geometry><material><diffuse>0.06 0.14 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Small targets exercise near-field detection and lidar sparsity. -->
    <model name="orange_cones">
      <static>true</static>
      <link name="cones">
        <collision name="c0"><pose>7 -1.2 0.40 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="v0"><pose>7 -1.2 0.40 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.70</length></cylinder></geometry><material><ambient>0.85 0.22 0.01 1</ambient><diffuse>1 0.32 0.01 1</diffuse></material></visual>
        <collision name="c1"><pose>8.3 -1.5 0.40 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="v1"><pose>8.3 -1.5 0.40 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.70</length></cylinder></geometry><material><ambient>0.85 0.22 0.01 1</ambient><diffuse>1 0.32 0.01 1</diffuse></material></visual>
        <collision name="c2"><pose>9.6 -1.8 0.40 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="v2"><pose>9.6 -1.8 0.40 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.70</length></cylinder></geometry><material><ambient>0.85 0.22 0.01 1</ambient><diffuse>1 0.32 0.01 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Sign and traffic light shapes create semantic camera targets and thin lidar returns. -->
    <model name="speed_limit_sign">
      <static>true</static><pose>5 7.15 0 0 0 0</pose>
      <link name="link">
        <collision name="pole_c"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="pole_v"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
        <collision name="sign_c"><pose>0 0 2.75 1.5708 0 0</pose><geometry><cylinder><radius>0.42</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="sign_v"><pose>0 0 2.75 1.5708 0 0</pose><geometry><cylinder><radius>0.42</radius><length>0.06</length></cylinder></geometry><material><ambient>0.85 0.05 0.04 1</ambient><diffuse>1 0.08 0.06 1</diffuse></material></visual>
        <visual name="sign_face"><pose>0 -0.036 2.75 1.5708 0 0</pose><geometry><cylinder><radius>0.32</radius><length>0.012</length></cylinder></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <model name="traffic_light">
      <static>true</static><pose>19 7.1 0 0 0 0</pose>
      <link name="link">
        <collision name="pole_c"><pose>0 0 1.7 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>3.4</length></cylinder></geometry></collision>
        <visual name="pole_v"><pose>0 0 1.7 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>3.4</length></cylinder></geometry><material><diffuse>0.20 0.20 0.20 1</diffuse></material></visual>
        <collision name="head_c"><pose>0 -0.10 3.55 0 0 0</pose><geometry><box><size>0.42 0.32 1.15</size></box></geometry></collision>
        <visual name="head_v"><pose>0 -0.10 3.55 0 0 0</pose><geometry><box><size>0.42 0.32 1.15</size></box></geometry><material><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="red"><pose>0 -0.275 3.88 1.5708 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.03</length></cylinder></geometry><material><emissive>1 0.02 0.02 1</emissive></material></visual>
        <visual name="amber"><pose>0 -0.275 3.55 1.5708 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.03</length></cylinder></geometry><material><diffuse>0.30 0.20 0.01 1</diffuse></material></visual>
        <visual name="green"><pose>0 -0.275 3.22 1.5708 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.03</length></cylinder></geometry><material><diffuse>0.01 0.25 0.03 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Occlusion wall hides a small target until the ego vehicle approaches. -->
    <model name="occlusion_zone">
      <static>true</static>
      <link name="wall">
        <pose>24 -7.0 1.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6.0 0.35 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.0 0.35 2.8</size></box></geometry><material><ambient>0.32 0.24 0.16 1</ambient><diffuse>0.48 0.36 0.22 1</diffuse></material></visual>
      </link>
      <link name="hidden_pedestrian">
        <pose>25.5 -6.2 0.95 0 0 0</pose>
        <collision name="body_c"><geometry><cylinder><radius>0.28</radius><length>1.55</length></cylinder></geometry></collision>
        <visual name="body_v"><geometry><cylinder><radius>0.28</radius><length>1.55</length></cylinder></geometry><material><ambient>0.10 0.55 0.42 1</ambient><diffuse>0.12 0.82 0.62 1</diffuse></material></visual>
        <collision name="head_c"><pose>0 0 1.0 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
        <visual name="head_v"><pose>0 0 1.0 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><diffuse>0.72 0.48 0.33 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Buildings create long shadows and large planar lidar features. -->
    <model name="roadside_buildings">
      <static>true</static>
      <link name="warehouse"><pose>35 13 3.5 0 0 0</pose><collision name="c"><geometry><box><size>16 8 7</size></box></geometry></collision><visual name="v"><geometry><box><size>16 8 7</size></box></geometry><material><ambient>0.34 0.36 0.39 1</ambient><diffuse>0.48 0.51 0.55 1</diffuse></material></visual></link>
      <link name="shop"><pose>8 -13 2.5 0 0 0</pose><collision name="c"><geometry><box><size>12 8 5</size></box></geometry></collision><visual name="v"><geometry><box><size>12 8 5</size></box></geometry><material><ambient>0.58 0.48 0.31 1</ambient><diffuse>0.72 0.60 0.38 1</diffuse></material></visual></link>
    </model>

    <gui fullscreen="0">
      <camera name="overview">
        <pose>-14 -20 16 0 0.48 0.78</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
